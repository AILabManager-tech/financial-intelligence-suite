# Financial Intelligence Suite — sample environment file
#
# Copy this file to `.env` (which is gitignored) and replace each placeholder
# with your own provider key. Never commit a populated `.env` file.

# Finnhub — primary source for quotes, fundamentals, company news, earnings,
# dividends, analyst ratings, SEC filings and peers. Get a key at
# https://finnhub.io/dashboard
FINNHUB_API_KEY=replace_with_your_finnhub_api_key

# Twelve Data — historical prices for the period selector. Get a key at
# https://twelvedata.com/account
TWELVE_DATA_API_KEY=replace_with_your_twelve_data_api_key

# Alpha Vantage — currently unused in production but kept here for parity
# with legacy notebooks. Get a key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=replace_with_your_alpha_vantage_api_key
