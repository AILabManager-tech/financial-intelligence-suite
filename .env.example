# Financial Intelligence Suite — sample environment file
#
# Copy this file to `.env` (which is gitignored) and replace each placeholder
# with your own provider key. Never commit a populated `.env` file.

# Finnhub — primary source for quotes, fundamentals, company news, earnings,
# dividends, analyst ratings, SEC filings and peers. Get a key at
# https://finnhub.io/dashboard
FINNHUB_API_KEY=replace_with_your_finnhub_api_key

# Twelve Data — historical prices for the period selector. Get a key at
# https://twelvedata.com/account
TWELVE_DATA_API_KEY=replace_with_your_twelve_data_api_key

# Alpha Vantage — currently unused in production but kept here for parity
# with legacy notebooks. Get a key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=replace_with_your_alpha_vantage_api_key

# exchangerate.host — OPTIONAL keyed fallback for FX rates. The FX feature works
# without it (Frankfurter / ECB is keyless and primary); set this only if you
# want the secondary provider enabled. Get a key at https://exchangerate.host
EXCHANGERATE_HOST_API_KEY=replace_with_your_exchangerate_host_api_key

# FRED (Federal Reserve, St. Louis) — OPTIONAL, powers the macro panel (P5.6:
# Fed funds rate, 2Y/10Y treasuries, 10Y-2Y spread). Free key at
# https://fredaccount.stlouisfed.org/apikeys — without it the macro panel shows
# an "unavailable" state (never fabricated values).
FRED_API_KEY=replace_with_your_fred_api_key

# Supabase (P7.1 — auth foundation) — OPTIONAL. When BOTH are set, the app
# enables accounts (login / sign-up); when either is missing it stays in solo,
# client-first localStorage mode (no accounts, full offline use) — same as before
# Phase 7. These VITE_-prefixed values are exposed to the browser bundle, which
# is fine: the publishable/anon key is public by design and Row-Level Security
# guards the data. NEVER put the Supabase service-role / secret key here.
# Project dashboard: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_supabase_publishable_or_anon_key

# Anthropic (P6.6 — meeting-topic selection) — OPTIONAL, and the only key that
# costs money per call. Powers /api/meeting-topics: it reads the recent news of
# the held positions and selects the subjects the client is likely to raise.
# Without it the endpoint returns hasData:false and the brief simply omits the
# section — never fabricated. Get a key at https://console.anthropic.com
# NOTE: server-side only (no VITE_ prefix) — this key must never reach the
# browser bundle. Each cache miss is one Claude call; the handler caps symbols
# and caches for 30 min to bound the spend.
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key

# Rate limiting (P8.1) — OPTIONAL, caps /api/* per IP to protect the Finnhub
# free quota. Defaults: 600 requests / 60s window per IP. Tune for production.
# NOTE: the in-memory limiter works for a single server (dev); on Vercel's
# per-instance serverless runtime use a shared store (Vercel KV / Upstash) for
# distributed limiting.
API_RATE_LIMIT=600
API_RATE_WINDOW_MS=60000
